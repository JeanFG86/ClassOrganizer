{
  "name": "classorganizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @classorganizer/api --filter @classorganizer/worker --filter @classorganizer/web dev",
    "build": "pnpm --filter @classorganizer/web build",
    "db:up": "docker compose -f compose.yaml -f compose.dev.yaml up -d --wait postgres",
    "db:migrate": "pnpm --filter @classorganizer/infrastructure db:migrate",
    "db:migrate:dev": "pnpm --filter @classorganizer/infrastructure db:migrate:dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "check:arch": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit --project web",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @classorganizer/e2e test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm check:arch && pnpm test",
    "engine:solve": "node apps/worker/src/generation/cli.ts",
    "benchmark:engine": "node apps/worker/src/generation/benchmark.ts",
    "engine:fixture": "node apps/worker/src/generation/synthetic-cli.ts",
    "admin:create": "node --env-file-if-exists=.env apps/api/src/bootstrap-admin.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "dependency-cruiser": "18.7.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
