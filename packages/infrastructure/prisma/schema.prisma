// Modelos de persistência. Não são entidades de domínio: os repositórios
// traduzem entre estes registros e os tipos de @classorganizer/core.

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model Subject {
  id             String    @id @db.Uuid
  name           String    @db.VarChar(80)
  normalizedName String    @unique(map: "subject_normalized_name_key") @map("normalized_name") @db.VarChar(80)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  version        Int       @default(1)

  teachers     TeacherSubject[]
  participants AssignmentParticipant[]

  @@map("subject")
}

/// Turma, com o turno e as aulas do turno que ela usa.
model ClassGroup {
  id             String    @id @db.Uuid
  name           String    @db.VarChar(40)
  normalizedName String    @unique(map: "class_group_normalized_name_key") @map("normalized_name") @db.VarChar(40)
  shiftId        String?   @map("shift_id") @db.Uuid
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  version        Int       @default(1)

  shift       Shift?               @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  periods     ClassGroupPeriod[]
  assignments TeachingAssignment[]

  /// Alvo da FK composta de class_group_period (a aula precisa ser do turno da turma).
  @@unique([id, shiftId], map: "class_group_id_shift_id_key")
  @@index([shiftId])
  @@map("class_group")
}

/// Turno (ex.: "Manhã"). Os intervalos são as lacunas entre as aulas.
model Shift {
  id             String    @id @db.Uuid
  name           String    @db.VarChar(40)
  normalizedName String    @unique(map: "shift_normalized_name_key") @map("normalized_name") @db.VarChar(40)
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(3)
  version        Int       @default(1)

  periods     ShiftPeriod[]
  classGroups ClassGroup[]

  @@map("shift")
}

/// Aula do turno, em minutos desde a meia-noite.
model ShiftPeriod {
  id          String @id @db.Uuid
  shiftId     String @map("shift_id") @db.Uuid
  startMinute Int    @map("start_minute") @db.SmallInt
  endMinute   Int    @map("end_minute") @db.SmallInt

  shift       Shift                   @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  classGroups ClassGroupPeriod[]
  unavailable TeacherUnavailability[]

  /// Alvo da FK composta de class_group_period.
  @@unique([id, shiftId], map: "shift_period_id_shift_id_key")
  @@index([shiftId])
  @@map("shift_period")
}

/// Aula do turno em que a turma tem aula. As duas FKs compostas repetem `shift_id`
/// para o banco garantir que a aula pertence ao turno da turma.
model ClassGroupPeriod {
  classGroupId String @map("class_group_id") @db.Uuid
  shiftId      String @map("shift_id") @db.Uuid
  periodId     String @map("period_id") @db.Uuid

  classGroup ClassGroup  @relation(fields: [classGroupId, shiftId], references: [id, shiftId], onDelete: Cascade)
  period     ShiftPeriod @relation(fields: [periodId, shiftId], references: [id, shiftId], onDelete: Restrict)

  @@id([classGroupId, periodId])
  @@index([periodId, shiftId])
  @@map("class_group_period")
}

model Teacher {
  id               String    @id @db.Uuid
  name             String    @db.VarChar(120)
  /// Máximo de aulas atribuídas por semana; nulo quando não há limite.
  maxWeeklyLessons Int?      @map("max_weekly_lessons") @db.SmallInt
  /// Hora-atividade: aulas por semana reservadas para planejamento.
  planningPeriods  Int       @default(0) @map("planning_periods") @db.SmallInt
  createdAt        DateTime  @map("created_at") @db.Timestamptz(3)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(3)
  version          Int       @default(1)

  subjects    TeacherSubject[]
  unavailable TeacherUnavailability[]

  @@map("teacher")
}

/// Horário (dia da semana + aula de um turno) em que o professor não pode dar aula.
/// Se a aula sai do turno, o horário indisponível deixa de existir junto.
model TeacherUnavailability {
  teacherId String @map("teacher_id") @db.Uuid
  /// 1 = segunda … 5 = sexta.
  weekday   Int    @db.SmallInt
  periodId  String @map("period_id") @db.Uuid

  teacher Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  period  ShiftPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@id([teacherId, weekday, periodId])
  @@index([periodId])
  @@map("teacher_unavailability")
}

/// Habilitação: disciplina que o professor pode lecionar.
model TeacherSubject {
  teacherId String @map("teacher_id") @db.Uuid
  subjectId String @map("subject_id") @db.Uuid
  /// Preserva a ordem informada no cadastro.
  position  Int    @db.SmallInt

  teacher      Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  participants AssignmentParticipant[]

  @@id([teacherId, subjectId])
  @@index([subjectId])
  @@map("teacher_subject")
}

/// Bloco de aulas simultâneas de uma turma. A carga vale para cada participante.
model TeachingAssignment {
  id            String   @id @db.Uuid
  classGroupId  String   @map("class_group_id") @db.Uuid
  weeklyLessons Int      @map("weekly_lessons") @db.SmallInt
  createdAt     DateTime @map("created_at") @db.Timestamptz(3)
  version       Int      @default(1)

  classGroup   ClassGroup              @relation(fields: [classGroupId], references: [id], onDelete: Restrict)
  participants AssignmentParticipant[]

  @@index([classGroupId])
  @@map("teaching_assignment")
}

/// Chave natural preservada ao editar; cada professor ocupa uma única participação no bloco.
model AssignmentParticipant {
  assignmentId String @map("assignment_id") @db.Uuid
  teacherId    String @map("teacher_id") @db.Uuid
  subjectId    String @map("subject_id") @db.Uuid
  position     Int    @db.SmallInt

  assignment    TeachingAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  subject       Subject            @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  /// Mantém a garantia de habilitação para todos os participantes.
  qualification TeacherSubject     @relation(fields: [teacherId, subjectId], references: [teacherId, subjectId], onDelete: Restrict)

  @@id([assignmentId, teacherId])
  @@index([teacherId, subjectId])
  @@index([subjectId])
  @@map("assignment_participant")
}

model AppUser {
  id String @id @db.Uuid
  username String @unique @db.VarChar(40)
  passwordHash String @map("password_hash") @db.VarChar(256)
  role String @db.VarChar(10)
  disabled Boolean @default(false)
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  sessions LoginSession[]
  audits AuditEvent[]
  revisions PlanningRevision[]
  timetableChanges TimetableChange[]
  @@map("app_user")
}
model LoginSession {
  tokenHash String @id @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  user AppUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([expiresAt])
  @@map("login_session")
}
model LoginAttempt {
  key String @id @db.Char(64)
  attempts Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("login_attempt")
}
model AppState {
  id Int @id
  catalogVersion Int @default(1) @map("catalog_version")
  @@map("app_state")
}
model AuditEvent {
  id String @id @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  action String @db.VarChar(80)
  entityId String? @map("entity_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  actor AppUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([occurredAt])
  @@index([entityId, occurredAt])
  @@map("audit_event")
}
model Planning {
  id String @id @db.Uuid
  name String @db.VarChar(100)
  year Int
  version Int @default(1)
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  copiedFromId String? @map("copied_from_id") @db.Uuid
  copiedFrom Planning? @relation("planning_copy", fields: [copiedFromId], references: [id], onDelete: Restrict)
  copies Planning[] @relation("planning_copy")
  revisions PlanningRevision[]
  @@map("planning")
}
model PlanningRevision {
  id String @id @db.Uuid
  planningId String @map("planning_id") @db.Uuid
  number Int
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  createdBy String @map("created_by") @db.Uuid
  snapshot Json
  gridRules Json @default("{\"formatVersion\":1,\"planningPeriods\":\"any_shift\",\"daily\":{\"maxPerDay\":2,\"consecutive\":true},\"dailyExceptions\":[]}") @map("grid_rules")
  rulesReviewed Boolean @default(false) @map("rules_reviewed")
  availabilityReviewed Boolean @default(false) @map("availability_reviewed")
  sealedAt DateTime? @map("sealed_at") @db.Timestamptz(3)
  planning Planning @relation(fields: [planningId], references: [id], onDelete: Restrict)
  creator AppUser @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  placements TimetablePlacement[]
  timetableChanges TimetableChange[]
  @@unique([planningId, number])
  @@map("planning_revision")
}
/// Alocação da grade de uma revisão; aponta para ids da fotografia, sem FK para cadastros (ADR 0013).
model TimetablePlacement {
  revisionId String @map("revision_id") @db.Uuid
  kind String @db.VarChar(10)
  entityId String @map("entity_id") @db.Uuid
  weekday Int @db.SmallInt
  periodId String @map("period_id") @db.Uuid
  pinned Boolean @default(false)
  revision PlanningRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  @@id([revisionId, kind, entityId, weekday, periodId])
  @@map("timetable_placement")
}
/// Histórico somente de acréscimo das alterações da grade.
model TimetableChange {
  id String @id @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  sequence Int
  actorId String @map("actor_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(3)
  kind String @db.VarChar(10)
  summary String
  delta Json
  revertsId String? @unique @map("reverts_id") @db.Uuid
  revision PlanningRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  actor AppUser @relation(fields: [actorId], references: [id], onDelete: Restrict)
  reverts TimetableChange? @relation("timetable_change_revert", fields: [revertsId], references: [id], onDelete: Restrict)
  revertedBy TimetableChange? @relation("timetable_change_revert")
  @@unique([revisionId, sequence])
  @@map("timetable_change")
}
