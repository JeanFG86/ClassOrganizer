# Copie para `.env` e ajuste. O `.env` nunca deve ser versionado.
# Os valores abaixo servem apenas para uso local/demonstração.

# Banco (use apenas letras, números, "-" e "_" na senha: ela compõe a URL de conexão)
POSTGRES_DB=classorganizer
POSTGRES_USER=classorganizer
POSTGRES_PASSWORD=troque-esta-senha-local

# Interface publicada pelo Compose. 127.0.0.1 = acessível só nesta máquina.
# Liberar na rede local exige decisão deliberada sobre autenticação e transporte.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

LOG_LEVEL=info

# ---- Desenvolvimento fora dos containers (`pnpm dev`) ----
# Banco exposto por compose.dev.yaml; mantenha usuário/senha iguais aos de cima.
DATABASE_URL=postgresql://classorganizer:troque-esta-senha-local@127.0.0.1:5432/classorganizer
API_PORT=3000

# Origem exata da interface; use HTTPS ao publicar em rede. Sem barra final.
APP_ORIGIN=http://localhost:8080
